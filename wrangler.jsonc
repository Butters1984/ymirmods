{
  "name": "ymirmods",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",

  "vars": {
    "DISCORD_CLIENT_ID": "1553756285868970024",
    "DISCORD_REDIRECT_URI": "https://ymirmods.com/api/auth/discord/callback"
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mod/*",
      "/creator/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ymirmods-db",
      "database_id": "64f33365-bf85-4c70-bc19-68747ca43b87"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MOD_FILES",
      "bucket_name": "ymirmods-files"
    }
  ]
}
